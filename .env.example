# Copy this file to `.env` for local development (`.env` is git-ignored).
# NEVER put real values in this file or commit real secrets.
# Fill real values only in your local `.env`, or as GitHub Actions / HF Spaces secrets.

# --- Runtime secrets (needed by the deployed app) ---
OPENROUTER_API_KEY=          # LLM calls via OpenRouter
HF_TOKEN=                    # durable memory: HF Dataset-sync store (ticket #22)

# --- Build-time only (used by the offline ingestion pull; NOT shipped to HF Spaces) ---
TMDB_API_KEY=                # TMDB v3 API key
TMDB_READ_ACCESS_TOKEN=      # TMDB v4 read token (alternative to the key)
